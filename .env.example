# NEORETAIL V9 MULTI-TENANT - copie para .env e nunca versione segredos.
SUPERSET_SECRET_KEY=troque-por-uma-chave-longa
GUEST_TOKEN_JWT_SECRET=troque-por-outra-chave-longa
SUPERSET_DB_PASSWORD=superset
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@localhost
SUPERSET_WORKERS=2
SUPERSET_THREADS=20
SUPERSET_TIMEOUT=180

# PostgreSQL Analytics separado da metadata do Superset.
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=analytics
ANALYTICS_DB_PORT=5433

# Azure Blob continua sendo a unica fonte real.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=neoretail
AZURE_BLOB_PREFIX=
BLOB_PROFILE_MAX_FILES=250
BLOB_PROFILE_SAMPLE_ROWS=1000
BLOB_PROFILE_INCLUDE_SAMPLES=false

# Engine local: PySpark + lake Parquet por padrao.
LOCAL_LAKE_FORMAT=parquet
LOCAL_DISCOVERY_MAX_FILES=5000
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
JUPYTER_TOKEN=neoretail-v9-local

# Cliente padrao para comandos locais. Aceita ID_CUSTOMER ou NM_CUSTOMER.
NEORETAIL_CUSTOMER=259
CUSTOMERS_CONFIG_PATH=/workspace/config/customers.yaml

PUBLIC_SUPERSET_URL=http://localhost:8088
EMBED_SESSION_SECRET=troque-por-uma-chave-de-sessao
DEMO_USER_PASSWORD=neoretail-demo

# Assistente analítico governado. Desabilitado por padrão e independente do stack core.
ASSISTANT_ENABLED=false
LLM_PROVIDER=mock
LLM_TIMEOUT_MS=20000
ASSISTANT_SQL_TIMEOUT_MS=8000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
